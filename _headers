# Caching, for hosts that read this file (Netlify, Cloudflare Pages; GitHub Pages ignores it;
# Vercel reads vercel.json, which says the same).
# The desk's assets are content-hashed (a new build gives them new names): cached for a year.
# Its page is checked every time, so a new build is seen at once.
/desk/assets/*
  Cache-Control: public, max-age=31536000, immutable
/desk/
  Cache-Control: no-cache
/desk/index.html
  Cache-Control: no-cache
